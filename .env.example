# Copy to .env (or set in your hosting dashboard). All settings are optional.

# Storage
VEV_DATABASE_PATH=./data/vev_audit.db
# Serve the dashboard from FastAPI (default ./frontend). Set to empty for API-only deployments.
# VEV_FRONTEND_DIR=

# Cross-origin frontends allowed to call the API (comma-separated), e.g. a Netlify site in "direct" mode
VEV_CORS_ORIGINS=

# Scan limits
VEV_MAX_PAGES_LIMIT=10
VEV_DEFAULT_MAX_PAGES=5
VEV_MAX_CRAWL_DEPTH=2
VEV_MAX_CONCURRENT_SCANS=2
VEV_NAVIGATION_TIMEOUT_MS=30000
VEV_SCAN_TIMEOUT_S=300
VEV_RESPECT_ROBOTS_TXT=true
# "All pages" mode
VEV_MAX_PAGES_ALL=200
VEV_MAX_CRAWL_DEPTH_ALL=10
VEV_SCAN_TIMEOUT_ALL_S=3600
# Parallel tabs per scan, and politeness delay between page loads (seconds)
VEV_PAGE_CONCURRENCY=3
VEV_PAGE_DELAY_S=0.5
VEV_PAGE_TIMEOUT_S=120

# Annotated screenshots
VEV_SCREENSHOTS_ENABLED=true
VEV_SCREENSHOT_DIR=./data/screenshots
VEV_MAX_SCREENSHOTS_PER_PAGE=25
VEV_MAX_SHOTS_PER_RULE=12

# Network safety
VEV_ALLOWED_PORTS=80,443,8080,8443
# NEVER enable in production: lets the scanner reach localhost/private networks (local dev only)
VEV_ALLOW_PRIVATE_NETWORKS=false

# Abuse protection (scans per client IP per window; 0 disables)
VEV_RATE_LIMIT_SCANS=10
VEV_RATE_LIMIT_WINDOW_S=3600
# Set true only when running behind a trusted reverse proxy (Render, Fly, Railway, Nginx)
VEV_TRUST_PROXY_HEADERS=false

# Branding (PDF/HTML reports)
VEV_BRAND_NAME=Vevkraft
VEV_BRAND_URL=https://vevkraft.com
# VEV_BRAND_LOGO_PATH=/path/to/your-logo.svg
